<?xml version="1.0" encoding="utf-8"?>
<!-- VEDAXI UI: the preview-video design language applied to the working app.
     Every functional id from the previous layout is preserved 1:1 — MainActivity untouched. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0712"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- HEADER: brand left, build label right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="VEDAXI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"
                android:textColor="#8B5CF6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile beta · actual UI"
                android:textSize="10sp"
                android:textColor="#6E6480" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A1E47" />

        <!-- HERO: Just say it. + orb -->
        <TextView
            android:id="@+id/title_vdx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Just say it."
            android:textSize="34sp"
            android:textStyle="bold|italic"
            android:fontFamily="serif"
            android:textColor="#F6F3FA" />

        <com.vdx.ui.VedaxiOrbView
            android:id="@+id/vedaxi_orb"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tap to speak"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#EDE7F5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Type instead · Spoken replies on"
            android:textSize="11sp"
            android:textColor="#6E6480"
            android:layout_marginTop="2dp" />

        <!-- INPUT (intent) -->
        <EditText
            android:id="@+id/text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:hint="Say or type what you want…"
            android:textColor="#EDE7F5"
            android:textColorHint="#6E6480"
            android:background="#150F26"
            android:padding="14dp"
            android:textSize="15sp"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <LinearLayout
            android:id="@+id/suggest_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <!-- STATUS = the caption bar (one plain-English sentence) -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="#150F26"
            android:textColor="#EDE7F5"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:text="Local phone features work without signing in." />

        <TextView
            android:id="@+id/permission_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="#F0A93B"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:background="#8B5CF6"
            android:textColor="#0A0712"
            android:text="Grant Microphone"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:background="#1A1030"
            android:textColor="#EDE7F5"
            android:text="Turn on VDX in Accessibility"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <!-- LABS (hidden until setup complete) -->
        <LinearLayout
            android:id="@+id/labs_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:text="VEDAXI / Labs"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:textColor="#8B5CF6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_test_youtube" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="YouTube" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_dialer" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Dialer" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_settings" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Settings" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_readscreen" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Read Screen" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_readsms" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Read SMS" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_call" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Call" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_whatsapp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="WhatsApp" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_uber" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Uber" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_sms" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="SMS" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_email" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Email" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_all" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#8B5CF6" android:textColor="#0A0712" android:text="Run All" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_clear_log" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Clear" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/harness_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="#0D0A14"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:typeface="monospace"
                android:text="" />

            <!-- BYOK AI keys card — one secure input per provider, validated on save.
                 Keys are stored in the encrypted KeyVault (never plain prefs). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:text="VEDAXI / AI keys"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:textColor="#8B5CF6" />

            <TextView
                android:id="@+id/ai_keys_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="6dp"
                android:text="Stored encrypted on-device (Android Keystore). Never leaves your phone."
                android:textSize="11sp"
                android:textColor="#6E6480"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:id="@+id/ai_keys_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Accessibility verbosity dial (Labs) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:text="VEDAXI / Speech level"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:textColor="#8B5CF6" />

            <LinearLayout
                android:id="@+id/speech_level_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- OUTSIDE REQUEST PATH (demo driver) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="22dp"
            android:text="VEDAXI / Outside request path"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#8B5CF6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:text="Simulates an outside driver asking VDX to do something. The request enters the SAME door, passes the SAME safety gates, and returns evidence — success, cancelled, unverified, or blocked."
            android:textSize="11sp"
            android:textColor="#6E6480" />

        <EditText
            android:id="@+id/demo_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:hint="e.g. WhatsApp Papa saying I will be late"
            android:textSize="13sp"
            android:textColor="#EDE7F5"
            android:textColorHint="#6E6480"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:background="#150F26"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_demo_send" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#8B5CF6" android:textColor="#0A0712" android:text="Send request" android:textAllCaps="false" android:textSize="12sp" />
            <Button android:id="@+id/btn_demo_clear" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#1A1030" android:textColor="#EDE7F5" android:text="Clear evidence" android:textAllCaps="false" android:textSize="12sp" />
        </LinearLayout>

        <!-- EVIDENCE: the honest-run ledger -->
        <TextView
            android:id="@+id/demo_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#0D0A14"
            android:textColor="#EDE7F5"
            android:textSize="11sp"
            android:typeface="monospace"
            android:text="" />

    </LinearLayout>
</ScrollView>
